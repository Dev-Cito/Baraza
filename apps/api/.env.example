DATABASE_URL=postgres://baraza:baraza@localhost:5434/baraza
DATABASE_SSL=false
# Dev only: auto-create tables from entities. Ignored when NODE_ENV=production.
DATABASE_SYNCHRONIZE=true
PORT=3000
# HS256 signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# jsonwebtoken format: 15m, 1h, 7d...
JWT_EXPIRES_IN=1h
